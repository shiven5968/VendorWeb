rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check user role from Firestore /users/{uid}
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: Check if user is authorized staff (Mess Committee or Warden)
    function isStaff() {
      return isAuthenticated() && (
        getUserRole() == 'warden' ||
        getUserRole() == 'mess_committee' ||
        getUserRole() == 'committee' ||
        (request.auth.token.email != null && (
          request.auth.token.email in ['anita@abes.ac.in', 'alok@abes.ac.in', 'warden@abes.ac.in', 'committee@abes.ac.in'] ||
          request.auth.token.email.matches('^warden.*@abes\\.ac\\.in$') ||
          request.auth.token.email.matches('^committee.*@abes\\.ac\\.in$')
        ))
      );
    }

    // SECTION 1: MEAL IMAGES (/meal-images/{allPaths=**} and /meals/{allPaths=**})
    // - Public/Student read access for displaying menu cards
    // - ONLY authorized Mess Committee & Chief Warden can upload or replace meal images
    // - Maximum file size: 5 MB (5 * 1024 * 1024 bytes)
    // - Allowed MIME formats: JPG, JPEG, PNG, WEBP
    match /meal-images/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff()
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if isStaff();
    }

    match /meals/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff()
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if isStaff();
    }

    // SECTION 2: DAILY MESS PHOTOS (/mess-photos/{allPaths=**})
    // - Public/Student/Staff read access for daily meal and kitchen inspection photos
    // - ONLY authorized Mess Committee & Chief Warden can upload or manage mess photos
    // - Maximum file size: 10 MB (10 * 1024 * 1024 bytes)
    // - Allowed MIME formats: JPG, JPEG, PNG, WEBP
    match /mess-photos/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff()
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if isStaff();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
