# MessMate Firebase Environment Configuration
# Copy this file to .env or .env.local and populate with your Firebase Project keys.

VITE_APP_TITLE="MessMate – Know Your Meal Before You Eat It"
VITE_HOSTEL_CAMPUS="ABES EC & ABESBS Campus, Ghaziabad"
VITE_MESS_CONTRACTOR="Naina Caters"

# Firebase Web App Credentials (From Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
