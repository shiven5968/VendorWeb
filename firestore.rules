rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // CORE HELPER FUNCTIONS & STRICT ROLE VERIFICATION
    // ===============================================================

    // Check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the caller matches the document owner UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safely retrieve caller's role from their /users/{uid} document
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'none';
    }

    // Role check: Student (STRICT: true ONLY when role == 'student')
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }

    // Role check: Chief Warden / ABES Officials
    function isWarden() {
      return isAuthenticated() && (
        getUserRole() == 'warden' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'warden@abes.ac.in' ||
          request.auth.token.email == 'anita@abes.ac.in' ||
          request.auth.token.email == 'alok@abes.ac.in' ||
          request.auth.token.email.matches('^warden.*@abes\\.ac\\.in$')
        ))
      );
    }

    // Role check: Mess Committee
    function isCommittee() {
      return isAuthenticated() && (
        getUserRole() == 'mess_committee' ||
        getUserRole() == 'committee' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'committee@abes.ac.in' ||
          request.auth.token.email.matches('^committee.*@abes\\.ac\\.in$')
        ))
      );
    }

    // Role check: Partner (Hotels, Gyms, Restaurants, Vendors)
    function isPartner() {
      return isAuthenticated() && (
        getUserRole() == 'partner' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'partner@abes.ac.in' ||
          request.auth.token.email.matches('^partner.*@abes\\.ac\\.in$') ||
          request.auth.token.email.matches('.*@partner\\.messmates\\.com$')
        ))
      );
    }

    // Authorized staff (Mess Committee or Warden)
    function isStaff() {
      return isCommittee() || isWarden();
    }


    // ===============================================================
    // 1. USERS COLLECTION (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      // Students can read ONLY their own profile; Warden and Committee can read profiles
      allow read: if isOwner(userId) || isStaff();

      // Initial registration: Users can create their own profile with role = 'student'
      // Warden and verified committee can create/seed accounts with authorized roles
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == userId 
                    && (request.resource.data.role == 'student' || isWarden() || (isCommittee() && request.resource.data.role in ['mess_committee', 'committee']));

      // Profile updates:
      // - Students can update their own personal info (name, hostelBlock, gender, dietPreference) without modifying points/role
      // - OR students can apply verified reward increments (<= 10 pts) or redemption deductions via atomic transaction
      // - Students CANNOT set arbitrary large reward balances
      // - Warden can update any user profile including role management
      allow update: if (isOwner(userId) 
                        && request.resource.data.get('role', 'student') == resource.data.get('role', 'student') 
                        && request.resource.data.get('uid', userId) == resource.data.get('uid', userId)
                        && request.resource.data.get('admissionNumber', '') == resource.data.get('admissionNumber', '')
                        && request.resource.data.get('email', '') == resource.data.get('email', '')
                        && (
                          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rewardPoints', 'points', 'collegeId', 'role']))
                          ||
                          (
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardPoints', 'lastLoginRewardDate', 'updatedAt'])
                            && request.resource.data.rewardPoints is number
                            && request.resource.data.rewardPoints >= resource.data.get('rewardPoints', 0)
                            && (request.resource.data.rewardPoints - resource.data.get('rewardPoints', 0)) <= 10
                          )
                          ||
                          (
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardPoints', 'updatedAt'])
                            && request.resource.data.rewardPoints is number
                            && request.resource.data.rewardPoints >= 0
                            && request.resource.data.rewardPoints < resource.data.get('rewardPoints', 0)
                          )
                        ))
                    || isWarden();

      // Account deletion is strictly restricted to Chief Warden
      allow delete: if isWarden();
    }


    // ===============================================================
    // 2. MEALS & MENU COLLECTION (/meals/{mealId})
    // ===============================================================
    match /meals/{mealId} {
      // Everyone authenticated can read the dining menu
      allow read: if isAuthenticated();

      // ONLY Mess Committee and Chief Warden can create, edit, or delete meals
      allow create, update, delete: if isStaff();
    }


    // ===============================================================
    // 3. RATINGS & FEEDBACK COLLECTION (/ratings/{ratingId})
    // ===============================================================
    match /ratings/{ratingId} {
      // Authenticated users can view community meal ratings & reviews
      allow read: if isAuthenticated();

      // ONLY verified students can create ratings (Committee & Warden cannot create student ratings)
      allow create: if isStudent() 
                    && request.resource.data.userId == request.auth.uid;

      // Students can ONLY update their own ratings; cannot transfer ownership or spoof userId
      allow update: if isStudent() 
                    && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid;

      // Students can delete their own ratings; Wardens can moderate / remove offensive reviews
      allow delete: if (isStudent() && resource.data.userId == request.auth.uid) 
                    || isWarden();
    }


    // ===============================================================
    // 4. COMPLAINTS COLLECTION (/complaints/{complaintId})
    // ===============================================================
    match /complaints/{complaintId} {
      // Students can read ONLY their own complaints; Staff (Committee & Warden) can read all complaints
      allow read: if (isStudent() && resource.data.userId == request.auth.uid) || isStaff();

      // ONLY verified students can file a complaint (must match auth UID, initial status must be 'PENDING')
      allow create: if isStudent() 
                    && request.resource.data.userId == request.auth.uid 
                    && request.resource.data.status == 'PENDING';

      // Status updates & management:
      // - Mess Committee & Warden can update complaint status (e.g., 'IN REVIEW', 'RESOLVED', 'REJECTED')
      // - Students can ONLY update their description while pending, and CANNOT alter status
      allow update: if isStaff() 
                    || (isStudent() 
                        && resource.data.userId == request.auth.uid 
                        && request.resource.data.status == resource.data.status 
                        && request.resource.data.userId == resource.data.userId);

      // Only Chief Warden can delete complaint records
      allow delete: if isWarden();
    }


    // ===============================================================
    // 5. POLLS COLLECTION (/polls/{pollId})
    // ===============================================================
    match /polls/{pollId} {
      // Authenticated users can read active menu replacement polls
      allow read: if isAuthenticated();

      // ONLY Mess Committee and Warden can create, edit, or delete polls
      allow create, update, delete: if isStaff();
    }


    // ===============================================================
    // 6. VOTES COLLECTION (/votes/{voteId})
    // ===============================================================
    match /votes/{voteId} {
      // Authenticated users can view poll vote counts
      allow read: if isAuthenticated();

      // ONLY verified students can cast a vote (Committee & Warden cannot cast student votes)
      allow create: if isStudent() 
                    && request.resource.data.userId == request.auth.uid;

      // Votes are strictly immutable once cast: NO user can modify or delete a vote
      allow update, delete: if false;
    }


    // ===============================================================
    // 7. REWARDS CATALOG & VENDOR REWARDS (/rewards/{rewardId} & /rewards_catalog/{rewardId})
    // ===============================================================
    match /rewards/{rewardId} {
      // Authenticated users and students can view active rewards; Partners and Staff can view all
      allow read: if isAuthenticated();

      // Partners and Staff can create and delete vendor offers
      allow create, delete: if isPartner() || isStaff();

      // Updates:
      // - Partners and Staff can update offer details, stock, status
      // - Authenticated students can atomically increment claimedCount when redeeming
      allow update: if isPartner() || isStaff() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedCount'])
      );
    }

    match /rewards_catalog/{rewardId} {
      // Authenticated users can browse the healthy rewards catalog
      allow read: if isAuthenticated();

      // ONLY Mess Committee and Warden can manage catalog items
      allow create, update, delete: if isStaff();
    }


    // ===============================================================
    // 8. REDEMPTIONS COLLECTION (/redemptions/{redemptionId})
    // ===============================================================
    match /redemptions/{redemptionId} {
      // Students can read their own redemptions; Partners and Staff can view redemptions
      allow read: if (isAuthenticated() && (
                    resource.data.studentId == request.auth.uid || 
                    resource.data.userId == request.auth.uid
                  )) || isPartner() || isStaff();

      // Verified students can create a reward redemption
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );

      // Partners can validate and mark voucher as REDEEMED
      // Staff / Warden can also update status
      allow update: if isPartner() || isStaff();

      // Only Chief Warden can delete redemption audit logs
      allow delete: if isWarden();
    }


    // ===============================================================
    // 9. PROTEIN LOGS (GYM MODE) (/protein_logs/{logId})
    // ===============================================================
    match /protein_logs/{logId} {
      // Students can read ONLY their own fitness protein logs; Warden can view for audit
      allow read: if (isStudent() && resource.data.userId == request.auth.uid) || isWarden();

      // ONLY verified students can create their own protein logs
      allow create: if isStudent() 
                    && request.resource.data.userId == request.auth.uid;

      // Students can update/delete ONLY their own protein logs
      allow update, delete: if isStudent() 
                            && resource.data.userId == request.auth.uid 
                            && (request.method == 'delete' || request.resource.data.userId == request.auth.uid);
    }


    // ===============================================================
    // 10. ADMISSION NUMBER DIRECTORY (/admission_map/{admissionNumber})
    // Public resolution of Student Admission Number -> College Email for login
    // ===============================================================
    match /admission_map/{admissionNumber} {
      // Public read allowed for Admission Number login resolution and pre-registration uniqueness
      allow read: if true;

      // Creation and update allowed during authenticated registration or healing by account owner or staff
      // ANTI-TAKEOVER: The authenticated user's OWN Firestore profile MUST authoritatively contain this exact admissionNumber
      allow create, update: if (isAuthenticated() 
                                && request.resource.data.uid == request.auth.uid 
                                && request.resource.data.email == request.auth.token.email
                                && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admissionNumber == admissionNumber)
                            || isStaff();

      // Deletion strictly reserved for Chief Warden
      allow delete: if isWarden();
    }


    // ===============================================================
    // 11. OTP VERIFICATION SESSIONS (/otp_sessions/{sessionKey})
    // STRICT ZERO-TRUST SECURITY: Direct client access is 100% DENIED.
    // The browser client has ZERO read, write, or delete permissions.
    // Privileged serverless functions access this collection via Firebase Admin SDK.
    // ===============================================================
    match /otp_sessions/{sessionKey} {
      allow read, write: if false;
    }

    // ===============================================================
    // 12. MUSCLE PASS SUBSCRIPTIONS (/subscriptions/{userId})
    // ===============================================================
    match /subscriptions/{userId} {
      // Students can read their own subscription state; Staff can audit
      allow read: if isOwner(userId) || isStaff();

      // Only serverless Admin SDK with verified Razorpay payment writes subscriptions
      allow write: if false;
    }

    // ===============================================================
    // 13. DAILY MESS PHOTOS (/mess_photos/{photoId})
    // ===============================================================
    match /mess_photos/{photoId} {
      // Authenticated users can view daily meal and inspection photos
      allow read: if isAuthenticated();

      // ONLY authorized Mess Committee & Chief Warden can upload mess photo metadata
      allow create, update: if isStaff();

      // Only Chief Warden can delete photo records
      allow delete: if isWarden();
    }

    // ===============================================================
    // 14. HYGIENE & AUDIT CHECKS (/hygiene_checks/{checkId})
    // ===============================================================
    match /hygiene_checks/{checkId} {
      // Authenticated users can view daily hygiene audit reports
      allow read: if isAuthenticated();

      // ONLY authorized Mess Committee & Chief Warden can submit hygiene checks
      allow create, update: if isStaff();

      // Only Chief Warden can delete hygiene audit logs
      allow delete: if isWarden();
    }

    // ===============================================================
    // 15. REWARD EVENTS LEDGER (/reward_events/{eventId})
    // Additive, immutable audit log of earned points
    // ===============================================================
    match /reward_events/{eventId} {
      // Students can read ONLY their own reward events; Staff can audit; null-safe for existence checks
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isStaff());

      // Creation allowed strictly for authenticated students with valid event types and point values (<= 10)
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.points is number
                    && request.resource.data.points > 0
                    && request.resource.data.points <= 10
                    && (
                      (request.resource.data.type == 'LOGIN' && request.resource.data.points == 2) ||
                      (request.resource.data.type == 'MEAL_RATING' && request.resource.data.points == 1)
                    );

      // Ledger is strictly append-only and immutable
      allow update, delete: if false;
    }

    // ===============================================================
    // 16. USER NOTIFICATIONS (/notifications/{notifId})
    // Real-time user-scoped notifications
    // ===============================================================
    match /notifications/{notifId} {
      // Students can read ONLY their own notifications; Staff can audit; null-safe for existence checks
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isStaff());

      // Creation & update allowed by student for their own events (e.g. rewards) or by Staff (e.g. complaint updates)
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isStaff());

      // Students can dismiss/delete their own notifications
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
