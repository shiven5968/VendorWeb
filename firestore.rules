rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to get the current user's role from their document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isWarden() {
      return isAuthenticated() && getUserRole() == 'warden';
    }
    
    function isCommittee() {
      return isAuthenticated() && (getUserRole() == 'mess_committee' || getUserRole() == 'committee');
    }

    // ===============================================================
    // USERS COLLECTION
    // ===============================================================
    match /users/{userId} {
      // Any authenticated user can read their own profile; wardens and committee can read user profiles
      allow read: if isOwner(userId) || isWarden() || isCommittee();
      
      // User can create their initial profile during registration, but role MUST be 'student' (or matched auth claim)
      allow create: if isOwner(userId) 
                    && request.resource.data.uid == userId 
                    && (request.resource.data.role == 'student' || isWarden() || isCommittee());
      
      // User can update their own profile fields (name, hostelBlock, gender, dietPreference, etc.),
      // but CANNOT change their own role!
      allow update: if isOwner(userId) 
                    && request.resource.data.role == resource.data.role;
      
      // Only wardens can delete or manage account roles
      allow delete: if isWarden();
    }

    // ===============================================================
    // MEALS / MENUS COLLECTION
    // ===============================================================
    match /meals/{mealId} {
      // Anyone authenticated can read the daily/weekly menu
      allow read: if isAuthenticated();
      
      // Only Mess Committee and Warden can create, edit, or delete meals
      allow write: if isCommittee() || isWarden();
    }

    // ===============================================================
    // RATINGS & FEEDBACK COLLECTION
    // ===============================================================
    match /ratings/{ratingId} {
      // All authenticated users can read ratings & reviews
      allow read: if isAuthenticated();
      
      // Students can create their own meal rating (must match authenticated uid)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can only update their own rating
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Wardens can moderate / remove offensive ratings
      allow delete: if isWarden();
    }

    // ===============================================================
    // COMPLAINTS COLLECTION
    // ===============================================================
    match /complaints/{complaintId} {
      // Students can read their own complaints; Wardens and Committee can read all complaints
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCommittee() || isWarden());
      
      // Students can file a new complaint
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid 
                    && request.resource.data.status == 'PENDING';
      
      // Only Committee and Warden can update complaint status (e.g. IN REVIEW, RESOLVED)
      allow update: if isCommittee() || isWarden();
      
      allow delete: if isWarden();
    }

    // ===============================================================
    // POLLS & VOTES COLLECTION
    // ===============================================================
    match /polls/{pollId} {
      // Anyone can read active polls
      allow read: if isAuthenticated();
      
      // Only Mess Committee and Warden can create or manage polls
      allow write: if isCommittee() || isWarden();
    }

    match /votes/{voteId} {
      allow read: if isAuthenticated();
      // One vote per user, authenticated user ID must match
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Votes are immutable once cast
    }

    // ===============================================================
    // PROTEIN LOGS & REWARDS
    // ===============================================================
    match /protein_logs/{logId} {
      allow read, write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    match /redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCommittee() || isWarden());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isCommittee() || isWarden();
    }
  }
}
